# Copy to .env and fill in. NEVER commit .env to git.

# Gemini API key (Google AI Studio): https://aistudio.google.com/apikey
# Needed for embeddings (default: gemini-embedding-2) and/or Gemini generation.
GOOGLE_API_KEY=

# Anthropic API key (https://console.anthropic.com) — pay-per-token, no free tier.
# Needed only when PAPER_RAG_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# --- Provider selection (defaults shown in src/paper_rag/config.py) ---
# Mixed setup "Claude answers + Gemini embeddings" (contract §8):
# PAPER_RAG_LLM_PROVIDER=anthropic
# PAPER_RAG_LLM_MODEL=claude-sonnet-5
# PAPER_RAG_EMBED_PROVIDER=gemini
# PAPER_RAG_EMBED_MODEL=gemini-embedding-2
# PAPER_RAG_EMBED_DIM=3072
# PAPER_RAG_CHUNKING=paragraph
